---
import { precio } from '../lib/format';
import type { Producto } from '../types';

type Props = Producto;

const { id, nombre, precio: valor, imagen, stock } = Astro.props;
---

<article class="tarjeta-producto">
  <img src={imagen} alt={nombre} width="190" height="150" loading="lazy" />
  <div class="tarjeta-producto-info">
    <h3>{nombre}</h3>
    <p class="precio">{precio(valor)}</p>
    {stock <= 0 && <p class="existencia agotado">Agotado</p>}
    {stock > 0 && stock <= 5 && <p class="existencia pocas">¡Solo quedan {stock}!</p>}
    <a class="ver-detalle-btn" href={`/producto/${id}`}>Ver detalles</a>
  </div>
</article>

<style>
  .tarjeta-producto {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .tarjeta-producto:hover {
    box-shadow: var(--shadow-soft);
    transform: translateY(-2px);
  }

  img {
    width: 100%;
    height: 150px;
    object-fit: cover;
  }

  .tarjeta-producto-info {
    padding: 0.9rem 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  h3 {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .precio {
    margin: 0;
    color: var(--honey-dark);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .existencia {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .existencia.agotado { color: var(--jam); }
  .existencia.pocas { color: var(--honey-dark); }

  .ver-detalle-btn {
    margin-top: auto;
    background: var(--cream);
    color: var(--espresso);
    padding: 0.55rem;
    border-radius: 8px;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .ver-detalle-btn:hover { background: var(--honey); }
</style>
