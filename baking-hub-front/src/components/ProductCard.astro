---
import { precio } from '../lib/format';
import type { Producto } from '../types';

type Props = Producto;

const { id, nombre, precio: valor, imagen, stock } = Astro.props;
---

<article class="tarjeta-producto">
  <img src={imagen} alt={nombre} width="190" height="150" loading="lazy" />
  <div class="tarjeta-producto-info">
    <h3>{nombre}</h3>
    <p class="precio">{precio(valor)}</p>
    {stock <= 0 && <p class="existencia agotado">Agotado</p>}
    {stock > 0 && stock <= 5 && <p class="existencia pocas">¡Solo quedan {stock}!</p>}
    <a class="ver-detalle-btn" href={`/producto/${id}`}>Ver detalles</a>
  </div>
</article>

<style>
  .tarjeta-producto {
    background: var(--surface);
    border: 1px solid rgba(120, 94, 82, 0.08);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-soft);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .tarjeta-producto:hover {
    box-shadow: 12px 12px 24px rgba(128, 103, 88, 0.2), -8px -8px 18px rgba(255,255,255,0.7);
    transform: translateY(-2px);
  }

  img {
    width: 100%;
    height: 150px;
    object-fit: cover;
  }

  .tarjeta-producto-info {
    padding: 0.9rem 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  h3 {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .precio {
    margin: 0;
    color: var(--primary-strong);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .existencia {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .existencia.agotado { color: var(--error-text); }
  .existencia.pocas { color: var(--primary-strong); }

  .ver-detalle-btn {
    margin-top: auto;
    background: var(--soft-button-surface);
    color: var(--text);
    padding: 0.7rem 0.8rem;
    border-radius: 14px;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    box-shadow: inset 2px 2px 5px rgba(255,255,255,0.75), inset -4px -4px 8px rgba(184, 154, 138, 0.18);
    transition: transform 0.15s ease;
  }

  .ver-detalle-btn:hover { transform: translateY(-1px); }
</style>
