---
import { CATEGORIAS } from '../lib/categorias';

interface Props {
  activa?: string;
}

const { activa } = Astro.props;
const href = (categoria: string) => (categoria === 'Todas' ? '/' : `/?categoria=${encodeURIComponent(categoria)}`);
---

<aside class="side-bar">
  <h3>Categorías</h3>
  <ul class="category-list">
    {
      CATEGORIAS.map((categoria) => (
        <li>
          <a
            class:list={['category-item', { activa: activa === categoria }]}
            href={href(categoria)}
            aria-current={activa === categoria ? 'page' : undefined}
          >
            {categoria === 'Todas' ? 'Ver todo' : categoria}
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<style>
  .side-bar {
    width: 220px;
    flex-shrink: 0;
    padding: 1.5rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--sidebar-surface);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--line);
  }

  .side-bar h3 {
    font-size: 0.95rem;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }

  .category-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .category-item {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 14px;
    color: var(--muted);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .category-item:hover {
    background: rgba(255,255,255,0.35);
    color: var(--text);
  }

  .category-item.activa {
    background: linear-gradient(135deg, var(--primary), var(--primary-strong));
    color: #fff;
    font-weight: 600;
    box-shadow: 8px 8px 18px rgba(165, 118, 91, 0.18);
  }

  @media (max-width: 768px) {
    .side-bar {
      width: 100%;
      border-radius: 22px;
      padding: 1rem 1.1rem;
    }

    .category-list {
      flex-direction: row;
      overflow-x: auto;
      gap: 0.5rem;
    }

    .category-item { white-space: nowrap; }
  }
</style>
