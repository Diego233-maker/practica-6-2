# Copia este archivo a ".env" y ajusta los valores según tu instalación de PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bakinghub
DB_HOST=localhost
DB_PORT=5432
PORT=4000

# Secreto para firmar los JWT (mínimo 32 caracteres, obligatorio). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcional: la cuenta con este correo obtiene rol "admin" al registrarse o al iniciar el backend.
# Cambia el valor en tu archivo .env local; no pongas aquí tu correo real.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------------------
# Pagos con Mercado Pago (tarjeta, OXXO, SPEI y billetera). La integración ya está hecha en pagos.js.
# ---------------------------------------------------------------------------------------
# simulado = NO llama a Mercado Pago (sirve para probar todas las pantallas del checkout).
# real     = cobra con tu cuenta de Mercado Pago (configura las credenciales reales).
# Con NODE_ENV=production el modo simulado se rechaza (cualquiera podría "simular" que pagó).
MP_MODO=simulado

# Métodos que aparecen en el checkout (quita los que no quieras): tarjeta, oxxo, spei, mercadopago
MP_METODOS=tarjeta,oxxo,spei,mercadopago

# Horas que tiene el cliente para pagar en OXXO / SPEI antes de que el pedido expire y se libere el stock
PEDIDO_EXPIRA_HORAS=72

# Máximo de pedidos pendientes de pago por cliente a la vez (evita que alguien aparte todo el inventario)
MAX_PEDIDOS_PENDIENTES=5

# Solo para MP_MODO=real:
# Access Token PRIVADO (Tus integraciones -> Credenciales). TEST-... para pruebas, APP_USR-... para producción. Nunca lo subas a git.
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones -> Webhooks -> Configurar notificaciones). Obligatoria si pones BACKEND_PUBLIC_URL.
MP_WEBHOOK_SECRET=
# URL pública https de este backend para los avisos (webhook). En desarrollo usa ngrok o cloudflared, p. ej. https://abc123.ngrok.app
# Opcional: si la dejas vacía, los pagos se confirman igual por consulta periódica a Mercado Pago (cada 5 min).
BACKEND_PUBLIC_URL=
# URL del frontend (a donde Mercado Pago regresa al cliente)
FRONTEND_URL=http://localhost:4321
