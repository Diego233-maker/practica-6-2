# Copia este archivo a ".env" y ajusta los valores según tu instalación de PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bakinghub
DB_HOST=localhost
DB_PORT=5432
PORT=4000

# Secreto para firmar los JWT (mínimo 32 caracteres, obligatorio). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcional: quien se registre con este correo obtiene rol "admin"
# (puede entrar al panel /admin, gestionar inventario y clientes). Regístrate tú primero con él.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------------------
# Pagos con Mercado Pago
# ---------------------------------------------------------------------------------------
# simulado = NO llama a Mercado Pago (sirve para probar todas las pantallas del checkout).
# real     = usa tu cuenta de Mercado Pago (primero completa las funciones TODO en pagos.js).
MP_MODO=simulado

# Métodos que aparecen en el checkout (quita los que no quieras): tarjeta, oxxo, spei, mercadopago
MP_METODOS=tarjeta,oxxo,spei,mercadopago

# Horas que tiene el cliente para pagar en OXXO / SPEI antes de que el pedido expire y se libere el stock
PEDIDO_EXPIRA_HORAS=72

# Solo para MP_MODO=real:
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL pública de este backend para los avisos (webhook). En desarrollo usa ngrok o cloudflared, p. ej. https://abc123.ngrok.app
BACKEND_PUBLIC_URL=
# URL del frontend (a donde Mercado Pago regresa al cliente)
FRONTEND_URL=http://localhost:4321
