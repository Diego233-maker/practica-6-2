# Copia este archivo a ".env" y ajusta los valores según tu instalación de PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bakinghub
DB_HOST=localhost
DB_PORT=5432
PORT=4000

# Secreto para firmar los JWT (mínimo 32 caracteres, obligatorio). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opcional: quien se registre con este correo obtiene rol "admin"
# (puede crear y eliminar productos). Regístrate tú primero con él.
ADMIN_EMAIL=
